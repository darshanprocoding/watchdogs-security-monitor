  view_file {
    absolute_path_uri: "file:///src/components/TopBar.tsx"
    end_line: 78
    content: "import React from \'react\';\nimport { ShieldAlert, ShieldCheck, Zap } from \'lucide-react\';\n\ninterface TopBarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  systemHealthy: boolean;\n  onEmergencyWipe: () => void;\n}\n\nexport const TopBar: React.FC<TopBarProps> = ({\n  activeTab,\n  setActiveTab,\n  systemHealthy,\n  onEmergencyWipe,\n}) => {\n  const navItems = [\n    { id: \'telemetry\', label: \'Telemetry & Heatmaps\' },\n    { id: \'policies\', label: \'Policy Studio\' },\n    { id: \'simulator\', label: \'Attack Simulator\' },\n    { id: \'audit\', label: \'Immutable Audit Logs\' },\n    { id: \'honeypot\', label: \'Honeypot Sandbox\' },\n    { id: \'integration\', label: \'Agent SDK\' },\n  ];\n\n  return (\n    <header className=\"border-b border-slate-800 bg-[#070b12] sticky top-0 z-40\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8\">\n        {/* Zone 1: Brand wordmark */}\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <div className=\"w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400\">\n            <ShieldCheck className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <span className=\"text-base font-bold tracking-tight text-white font-sans uppercase\">\n              WATCHDOGS\n            </span>\n            <span className=\"text-xs text-slate-400 ml-2 hidden sm:inline\">\n              Runtime Security Proxy\n            </span>\n          </div>\n        </div>\n\n        {/* Zone 2: Navigation Links */}\n        <nav className=\"hidden md:flex items-center gap-6 text-sm font-medium\">\n          {navItems.map((item) => {\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => setActiveTab(item.id)}\n                className={`transition-colors whitespace-nowrap cursor-pointer pb-1 ${\n                  isActive\n                    ? \'text-emerald-400 border-b-2 border-emerald-400 font-semibold\'\n                    : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                {item.label}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Zone 3: Primary Action */}\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <button\n            onClick={onEmergencyWipe}\n            className=\"flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-rose-500/15 border border-rose-500/40 text-rose-300 hover:bg-rose-500/25 transition-colors whitespace-nowrap cursor-pointer\"\n            title=\"Forcefully purge primary agent short-term context memory\"\n          >\n            <ShieldAlert className=\"w-3.5 h-3.5 text-rose-400\" />\n            <span>Emergency Context Wipe</span>\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 79
    num_bytes: 2897
    line_range_bytes: 2897
  }
}
